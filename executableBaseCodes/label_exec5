using System;
using bpac;

namespace LabelPrinter5
{
    // Case 2-2 (Rev2): Heisin Shiga / 兵神装備 滋賀 — Drawing Number TEC-4301259 (regardless of #)
    class Program
    {
        static int Main(string[] args)
        {
            if (args.Length < 3)
            {
                Console.WriteLine("Usage: LabelPrinter5.exe <PartsNum> <DrawingNum> <PrintQuantity>");
                return 1;
            }

            string partsNum = args[0];
            string drawingNum = args[1];
            int printQuantity = 1;

            if (!int.TryParse(args[2], out printQuantity) || printQuantity < 1)
            {
                Console.WriteLine("Invalid print quantity. Using 1.");
                printQuantity = 1;
            }

            // Path to the .lbx label template for API 5
            string templatePath = @"C:\Users\pws_qc\Desktop\Arnav_Repository\Tecdia_Silver_Sticker_Label\labels\label_7.lbx";
            Document doc = new Document();

            if (!doc.Open(templatePath))
            {
                Console.WriteLine("Failed to open label template (Label5) at: " + templatePath);
                return 1;
            }

            try
            {
                // Set values in label template
                doc.GetObject("PartsNum").Text = partsNum;
                doc.GetObject("DrawingNum").Text = drawingNum;

                // Begin printing
                doc.StartPrint("", PrintOptionConstants.bpoDefault);
                doc.PrintOut(printQuantity, PrintOptionConstants.bpoDefault);
                doc.EndPrint();

                Console.WriteLine($"Printed {printQuantity} labels (Label5)");
                return 0;
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error during label printing (Label5): " + ex.Message);
                return 1;
            }
            finally
            {
                doc.Close();
            }
        }
    }
}
