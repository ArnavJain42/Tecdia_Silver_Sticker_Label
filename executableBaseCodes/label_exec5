using bpac;
using System;
using System.IO;

namespace LabelPrinter5
{
    // Case 2-2 (Rev2): Heisin Shiga / 兵神装備 滋賀 — Drawing Number TEC-4301259 (regardless of #)
    class Program
    {
        static int Main(string[] args)
        {
            // 1. Check for the 3 required parameters
            if (args.Length < 3)
            {
                Console.WriteLine("Usage: LabelPrinter5.exe <PartsNum> <DrawingNum> <PrintQuantity>");
                return 1;
            }

            string partsNum = args[0];
            string drawingNum = args[1];
            int printQuantity = 1;

            if (!int.TryParse(args[2], out printQuantity) || printQuantity < 1)
            {
                Console.WriteLine("Invalid print quantity. Using 1.");
                printQuantity = 1;
            }

            // Path to the Label 5 (Heisin Shiga) template
            string templatePath = @"C:\Users\pws_qcqa\Desktop\Arnav_Repository\Tecdia_Silver_Sticker_Label\labels\label_7.lbx";

            if (!File.Exists(templatePath))
            {
                Console.WriteLine("Error: Template file label_7.lbx not found.");
                return 1;
            }

            Document doc = new Document();

            // 2. Open the template FIRST
            if (!doc.Open(templatePath))
            {
                Console.WriteLine("Failed to open label template.");
                return 1;
            }

            try
            {
                // 3. Set printer AFTER opening to handle the "Copy 1" issue automatically
                doc.SetPrinter("", true);

                // 4. Set both fields; abort rather than print a label with a blank field
                if (!SetTextSafe(doc, "PartsNum", partsNum) || !SetTextSafe(doc, "DrawingNum", drawingNum))
                {
                    return 1;
                }

                // 5. Print with High Resolution for bold/thick lines
                PrintOptionConstants qualityOption = PrintOptionConstants.bpoHighResolution;

                doc.StartPrint("Label5", qualityOption);
                doc.PrintOut(printQuantity, qualityOption);
                doc.EndPrint();

                Console.WriteLine($"Printed {printQuantity} label(s) successfully.");
                return 0;
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error during label printing: " + ex.Message);
                return 1;
            }
            finally
            {
                doc.Close();
            }
        }

        // Helper to ensure the program doesn't crash if an object name is missing
        static bool SetTextSafe(Document doc, string objName, string text)
        {
            var obj = doc.GetObject(objName);
            if (obj != null)
            {
                obj.Text = text;
                return true;
            }

            Console.WriteLine($"Error: Object '{objName}' not found in label_7.lbx.");
            return false;
        }
    }
}
